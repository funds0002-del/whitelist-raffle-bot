  if (!raffle) return res.status(404).json({ error: 'Raffle not found' });
  res.json(formatRaffle(raffle));
});</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">app.post('/api/raffles/:id/enter', async (req, res) =&gt; {
  const raffleId = String(req.params.id || '').toUpperCase();
  const email = String(req.body.email || '').trim();
  const discordId = String((req.session.user &amp;&amp; req.session.user.id) || req.body.discordId || '').trim();
  if (!/^[^\s@]+@[^\s@]+</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">\.</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">[^\s@]+$/.test(email)) return res.status(400).json({ error: 'Enter a valid email address.' });
  if (!/^\d{15,25}$/.test(discordId)) return res.status(400).json({ error: 'Login with Discord first.' });</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">  const data = loadRaffles();
  const raffle = data.raffles[raffleId];
  if (!raffle) return res.status(404).json({ error: 'Raffle not found.' });
  if (raffle.status !== 'active' || Date.now() &gt;= raffle.endTime) return res.status(400).json({ error: 'This raffle is no longer accepting entries.' });
  if ((raffle.participants || []).includes(discordId)) return res.status(400).json({ error: 'You have already entered this raffle.' });</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">  const guildSettings = loadJson(path.join(__dirname, 'data', 'guilds.json'), { guilds: {} });
