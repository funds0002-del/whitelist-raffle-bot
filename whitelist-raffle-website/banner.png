  let bannerName = '';
  if (req.file) {
    const ext = path.extname(req.file.originalname || '') || '.png';
    bannerName = raffleId + ext;
    fs.renameSync(req.file.path, path.join(uploadFolder, bannerName));
    bannerUrl = '/uploads/' + bannerName;
  }</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">  const endTime = Date.now() + hours * 60 * 60 * 1000;
  const payload = {
