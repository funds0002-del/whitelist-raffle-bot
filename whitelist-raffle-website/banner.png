const email = document.getElementById('email').value.trim();
const discordId = document.getElementById('discord-id').value.trim();
const result = document.getElementById('result');

result.textContent = 'Saving...';

try {
  const response = await fetch(`/api/raffles/${raffle.id}/enter`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ email, discordId })
  });

  const data = await response.json();

  if (!response.ok) {
    result.textContent = data.error || 'Could not enter raffle.';
    return;
  }

  result.textContent = `${data.message} Total entries: ${data.entries}`;
} catch (error) {
  result.textContent = 'Could not connect to the raffle server.';
