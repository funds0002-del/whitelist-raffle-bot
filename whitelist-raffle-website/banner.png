lass="token" style="color: rgb(206, 145, 120);">'/api/teams/:id/invite-link'</span><span class="token" style="color: rgb(212, 212, 212);">,</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">(</span><span class="token" style="color: rgb(156, 220, 254);">req</span><span class="token" style="color: rgb(212, 212, 212);">,</span><span class="token" style="color: rgb(156, 220, 254);"> res</span><span class="token" style="color: rgb(212, 212, 212);">)</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">=&gt;</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">{</span><span>
</span><span>  </span><span class="token" style="color: rgb(86, 156, 214);">const</span><span> user </span><span class="token" style="color: rgb(212, 212, 212);">=</span><span> req</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>session</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>user</span><span class="token" style="color: rgb(212, 212, 212);">;</span><span>
</span><span>  </span><span class="token" style="color: rgb(86, 156, 214);">const</span><span> data </span><span class="token" style="color: rgb(212, 212, 212);">=</span><span> </span><span class="token" style="color: rgb(220, 220, 170);">loadJson</span><span class="token" style="color: rgb(212, 212, 212);">(</span><span>teamsFile</span><span class="token" style="color: rgb(212, 212, 212);">,</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">{</span><span> </span><span class="token literal-property" style="color: rgb(156, 220, 254);">teams</span><span class="token" style="color: rgb(212, 212, 212);">:</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">{</span><span class="token" style="color: rgb(212, 212, 212);">}</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">}</span><span class="token" style="color: rgb(212, 212, 212);">)</span><span class="token" style="color: rgb(212, 212, 212);">;</span><span>
