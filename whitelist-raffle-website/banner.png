  })
  .catch(() =&gt; {
    const list = document.getElementById('raffle-list');
    if (list) list.innerHTML = '</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">&lt;p class="meta"&gt;</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Could not load raffles. Start the website server.</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">&lt;/p&gt;</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">';
  });
  async function updateAuthNav() {
  try {
    const me = await fetch('/api/me').then(r =&gt; r.json());
    const links = document.querySelectorAll('a[href="/auth/discord"]');
    links.forEach(link =&gt; {
      if (me &amp;&amp; me.username) {
        link.textContent = me.username;
        link.href = '/logout';
      }
    });
  } catch (error) {}
