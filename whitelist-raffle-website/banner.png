</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">&lt;section class="hero"&gt;
  &lt;div class="status" id="status"&gt;ACTIVE&lt;/div&gt;
  &lt;h1 id="title"&gt;Raffle&lt;/h1&gt;
  &lt;p id="description"&gt;&lt;/p&gt;
  &lt;p class="meta" id="meta"&gt;&lt;/p&gt;
&lt;/section&gt;

&lt;section class="card" style="padding:18px; margin-bottom:80px;"&gt;
  &lt;h3&gt;Enter this raffle&lt;/h3&gt;
  &lt;p class="meta"&gt;This first version saves the entry locally until we connect Discord login.&lt;/p&gt;
  &lt;p style="margin:12px 0;"&gt;</span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">  &lt;input id="discord-id" placeholder="Discord user ID" style="width:100%; padding:12px; border-radius:10px; border:1px solid #2a2a38; background:#0f0f16; color:white;"&gt;
&lt;/p&gt;
      &lt;p style="margin:12px 0;"&gt;
        &lt;input id="email" placeholder="Email address" style="width:100%; padding:12px; border-radius:10px; border:1px solid #2a2a38; background:#0f0f16; color:white;"&gt;
      &lt;/p&gt;
      &lt;button class="btn" id="enter-btn"&gt;Enter raffle&lt;/button&gt;
      &lt;p class="meta" id="result" style="margin-top:12px;"&gt;&lt;/p&gt;
    &lt;/section&gt;
  &lt;/div&gt;
  &lt;script src="app.js"&gt;&lt;/script&gt;
&lt;/body&gt;
