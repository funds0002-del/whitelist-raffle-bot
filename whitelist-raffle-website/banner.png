    members: [{ discordId: user.id, username: user.username, role: 'owner' }],
    createdAt: Date.now()
  };
  saveJson(teamsFile, data);
  res.json(data.teams[id]);
});</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">app.get('/api/collabs', (req, res) =&gt; {
  const user = req.session.user;
