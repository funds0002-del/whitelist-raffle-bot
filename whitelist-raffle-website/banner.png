</span><span>      </span><span class="token" style="color: rgb(106, 153, 85);">// ADD PARTICIPANT</span><span>
</span><span>      </span><span class="token" style="color: rgb(106, 153, 85);">// ==============================</span><span>
</span>
<span>      raffle</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>participants</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span class="token" style="color: rgb(220, 220, 170);">push</span><span class="token" style="color: rgb(212, 212, 212);">(</span><span>
</span><span>        interaction</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>user</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>id
</span><span>      </span><span class="token" style="color: rgb(212, 212, 212);">)</span><span class="token" style="color: rgb(212, 212, 212);">;</span><span>
</span>
<span>      </span><span class="token" style="color: rgb(220, 220, 170);">saveRaffles</span><span class="token" style="color: rgb(212, 212, 212);">(</span><span>
</span>        raffleData
<span>      </span><span class="token" style="color: rgb(212, 212, 212);">)</span><span class="token" style="color: rgb(212, 212, 212);">;</span></code></pre></div></div><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Keep scrolling a little. Under that you will also see:</span></span></span></span><ul dir="ltr" style="display: block; padding-inline-start: 2em; list-style-type: disc; margin-block: 0px 1.25em;"><li style="font-family: TwitterChirp, System; margin-top: 0px;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-dyfej2 r-z2wwpe r-15gepa6 r-1471scf r-1aiqnjv r-1hq4qhi r-16dba41 r-ilng1c r-trst2h r-1noe1sz r-njp1lv"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">UPDATE ENTRY COUNT</span></span></span></li><li style="font-family: TwitterChirp, System; margin-top: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-dyfej2 r-z2wwpe r-15gepa6 r-1471scf r-1aiqnjv r-1hq4qhi r-16dba41 r-ilng1c r-trst2h r-1noe1sz r-njp1lv"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">SUCCESS MESSAGE</span></span></span></li></ul><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1adg3ll r-1g7jtus r-1x3r274" style="direction: ltr;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Those 3 sections belong to the old enter flow. They add the person, update the number on the raffle embed, then say “You have successfully entered”.</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-