</span>
<span>  </span><span class="token" style="color: rgb(86, 156, 214);">if</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">(</span><span>me </span><span class="token" style="color: rgb(212, 212, 212);">&amp;&amp;</span><span> me</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>id </span><span class="token" style="color: rgb(212, 212, 212);">&amp;&amp;</span><span> discordBox</span><span class="token" style="color: rgb(212, 212, 212);">)</span><span> </span><span class="token" style="color: rgb(212, 212, 212);">{</span><span>
</span><span>    discordBox</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>parentElement</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>style</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>display </span><span class="token" style="color: rgb(212, 212, 212);">=</span><span> </span><span class="token" style="color: rgb(206, 145, 120);">'none'</span><span class="token" style="color: rgb(212, 212, 212);">;</span><span>
