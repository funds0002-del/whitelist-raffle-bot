-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">Next is an invite link, so you do not have to paste a Discord ID.</span></span></span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1blvdjr r-vrz42v r-b88u0q" style="display: block; direction: ltr; margin-top: 1.5em; margin-bottom: 0.5em;"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">1. Add these two routes in </span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-dyfej2 r-z2wwpe r-15gepa6 r-1471scf r-1aiqnjv r-1hq4qhi r-16dba41 r-ilng1c r-trst2h r-1noe1sz r-njp1lv"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">server.js</span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3 r-1x3r274"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">, above </span></span><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-dyfej2 r-z2wwpe r-15gepa6 r-1471scf r-1aiqnjv r-1hq4qhi r-16dba41 r-ilng1c r-trst2h r-1noe1sz r-njp1lv"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">app.listen</span></span></span></span><div class="css-g5y9jx r-1adg3ll r-ag158w r-dnmrzs r-1yx7oqi r-13qz1uu"><div class="css-g5y9jx r-dnmrzs r-1adg3ll r-13qz1uu" data-testid="markdown-code-block"><div class="css-g5y9jx r-1awozwy r-1fkb3t2 r-1fs5b29 r-1idry7j r-6413gk r-43g30s r-l4nmg1 r-1u658rm r-2dysd3 r-vmopo1 r-13qz1uu r-gtdqiz r-1fhadnw r-184en5c"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-1aiqnjv r-n6v787"><span class="css-1jxf684 r-bcqeeo r-1ttztb7 r-qvutc0 r-poiln3">js</span></span><div class="css-g5y9jx r-1awozwy r-6koalj r-18u37iz r-z5qs1h r-17s6mgv"><button aria-label="Copy to clipboard" role="button" class="css-g5y9jx r-xoduu5 r-sdzlij r-1phboty r-rs99b7 r-lrvibr r-1ceczpf r-lp5zef r-1loqt21 r-o7ynqc r-6416eg r-1ny4l3l" type="button" s