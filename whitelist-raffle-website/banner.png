</span><span>    </span><span class="token literal-property" style="color: rgb(156, 220, 254);">title</span><span class="token" style="color: rgb(212, 212, 212);">:</span><span> raffle</span><span class="token" style="color: rgb(212, 212, 212);">.</span><span>title</span><span class="token" style="color: rgb(212, 212, 212);">,</span><span>
